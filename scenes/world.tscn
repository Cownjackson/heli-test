[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

// World-space grid so speed and altitude are readable without any textures.
uniform float cell_size = 10.0;
uniform vec3 color_a : source_color = vec3(0.20, 0.26, 0.18);
uniform vec3 color_b : source_color = vec3(0.23, 0.30, 0.21);
uniform vec3 line_color : source_color = vec3(0.38, 0.47, 0.33);

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 cell = world_pos.xz / cell_size;
	vec2 grid = abs(fract(cell - 0.5) - 0.5) / fwidth(cell);
	float line = 1.0 - min(min(grid.x, grid.y), 1.0);
	float checker = mod(floor(cell.x) + floor(cell.y), 2.0);
	ALBEDO = mix(mix(color_a, color_b, checker), line_color, line);
	ROUGHNESS = 1.0;
	SPECULAR = 0.05;
}
"

[sub_resource type="ShaderMaterial" id="Mat_ground"]
